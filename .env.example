# Development-only values. Never reuse these outside an isolated local network.

POSTGRES_DB=orvolt
POSTGRES_USER=orvolt
POSTGRES_PASSWORD=orvolt_dev_only
POSTGRES_DSN=postgres://orvolt:orvolt_dev_only@postgres:5432/orvolt?sslmode=disable

MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_TOPIC=orvolt/simulators/evse/telemetry

NATS_URL=nats://nats:4222
NATS_SUBJECT=orvolt.telemetry.evse.v1
ENERGY_NATS_SUBJECT=orvolt.energy.site.v1

EDGE_ID=edge-dev-001
SITE_ID=site-dev-001
HTTP_ADDR=:8080

# Edge store-and-forward. On real hardware SPOOL_DIR must point at storage that
# survives a power cut, and SPOOL_MAX_BYTES must fit the device's flash budget.
SPOOL_DIR=/var/lib/orvolt/spool
SPOOL_SEGMENT_BYTES=4194304
SPOOL_MAX_BYTES=268435456
PUBLISH_BATCH_SIZE=64
FLUSH_INTERVAL_MS=500
OBSERVABILITY_ADDR=0.0.0.0:9090

# JetStream retention. Streams must be bounded or the broker's disk fills and
# the fleet stops being able to publish.
STREAM_MAX_AGE=720h
STREAM_MAX_BYTES=8589934592
INGEST_BATCH_SIZE=256
INGEST_BATCH_INTERVAL=250ms
STATION_SILENCE_AFTER=5m

# Device and service identity. Leave empty for anonymous local development;
# both are required for any deployment reachable from an untrusted network.
NATS_CREDENTIALS=
NATS_CA_FILE=
