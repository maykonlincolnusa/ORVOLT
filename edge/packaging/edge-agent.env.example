# /etc/orvolt/edge-agent.env
#
# Read by the systemd unit. Values here are per-device: EDGE_ID and SITE_ID are
# what let the control plane attribute an observation to a physical location.

# Site-local broker. On a real charger this is the EVSE runtime's MQTT broker,
# reachable only over the station's internal network.
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_TOPIC=orvolt/evse/telemetry

# Cloud event bus. Must be TLS in any deployment that leaves the bench.
NATS_URL=tls://bus.example.net:4222
NATS_SUBJECT=orvolt.telemetry.evse.v1

# Device identity. Provision one credential file per charger; a shared
# credential means one compromised station can impersonate the whole fleet.
NATS_CREDENTIALS=/etc/orvolt/edge-agent.creds

# Identity of this installation.
EDGE_ID=edge-0001
SITE_ID=site-0001

# Store-and-forward. SPOOL_DIR is provided by the unit's StateDirectory and
# must survive both a power cut and an A/B system update.
SPOOL_SEGMENT_BYTES=4194304
# Size this against the device's free flash and how long an outage must be
# survivable. At roughly 120 bytes per record and one record per second,
# 64 MiB buffers about six days for a single connector.
SPOOL_MAX_BYTES=67108864

# Delivery pacing. Larger batches cost less per record on a high-latency link.
PUBLISH_BATCH_SIZE=64
FLUSH_INTERVAL_MS=500

# Local diagnostics. Bind to loopback unless a site gateway scrapes it: this
# endpoint exposes the station's operational state.
OBSERVABILITY_ADDR=127.0.0.1:9090

RUST_LOG=info
